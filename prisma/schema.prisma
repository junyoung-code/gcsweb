generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  password            String?
  nickname            String         @unique
  name                String
  phone               String?
  memberType          Int            @default(0)
  isSeller            Boolean        @default(false)
  studentId           String?
  major               String?
  profileImage        String?
  isVerified          Boolean        @default(false)
  signupMethod        SignupMethod   @default(EMAIL)
  isRepresentative    Boolean        @default(false)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  providerId          String?
  carts               Cart[]
  inquiries           Inquiry[]
  likes               Like[]
  notifications       Notification[]
  orders              Order[]
  scraps              Scrap[]
  store               Store?
  teams               Team[]

  @@index([email])
  @@index([nickname])
  @@index([memberType])
}

model Team {
  id                     String       @id @default(cuid())
  userId                 String
  teamName               String       @unique
  representativeName     String
  representativeNickname String
  teamMember             String[]
  teamMemberNickname     String[]
  accountUrl             String
  totalSales             Int?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  isSalesTeam            Boolean      @default(false)
  products               Product[]
  projects               Project[]
  settlements            Settlement[]
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teamName])
}

model Product {
  id                  String           @id @default(cuid())
  teamId              String
  name                String
  description         String
  type                Int              @default(0)
  status              Int              @default(0)
  price               Int
  goalAmount          Int?
  currentAmount       Int              @default(0)
  salesStartDate      DateTime
  salesEndDate        DateTime
  productionStartDate DateTime?
  deliveryStartDate   DateTime?
  receiveMethod       Int?
  isPublic            Boolean          @default(false)
  likeCount           Int              @default(0)
  viewCount           Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  productionEndDate   DateTime?
  deliveryEndDate     DateTime?
  pickupStartDate     DateTime?
  pickupEndDate       DateTime?
  pickupLocation      String?
  isHome              Boolean          @default(false)
  isAdminApproved     Boolean          @default(false)
  publicAt            DateTime?
  cartItems           CartItem[]
  likes               Like[]
  orderItems          OrderItem[]
  team                Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  images              ProductImage[]   @relation("ProductImages")
  options             ProductOption[]
  variants            ProductVariant[]
  scraps              Scrap[]

  @@index([teamId])
  @@index([type])
  @@index([status])
  @@index([isPublic])
}

model ProductOption {
  id         String               @id @default(cuid())
  productId  String
  optionName String
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values     ProductOptionValue[]

  @@unique([productId, optionName])
  @@index([productId])
}

model ProductOptionValue {
  id              String        @id @default(cuid())
  optionId        String
  value           String
  additionalPrice Int           @default(0)
  productId       String
  optionName      String
  option          ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, value])
  @@index([optionId])
  @@index([productId])
  @@index([productId, optionName])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  variantName     String?
  unitPrice       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isSoldOut       Boolean  @default(false)
  optionSignature String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, optionSignature])
  @@index([productId])
  @@index([productId, isSoldOut])
}

model ProductImage {
  id              String   @id @default(cuid())
  productId       String
  thumbnailImgUrl String
  detailImgUrl    String[]
  createdAt       DateTime @default(now())
  noticeImgUrl    String?
  product         Product  @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id                    String      @id @default(cuid())
  userId                String?
  paymentAmount         Int
  orderDate             DateTime    @default(now())
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  productType           Int
  receiveMethod         Int
  receiverName          String?
  receiverPhone         String?
  deliveryZipCode       String?
  deliveryAddressMain   String?
  deliveryAddressDetail String?
  deliveryMessage       String?
  ordererName           String?
  ordererPhone          String?
  paymentStatus         Int         @default(0)
  fulfillmentStatus     Int?
  paymentMethod         Int
  cardCompany           Int?
  bankCode              Int?
  easyPayProvider       Int?
  billingKey            String?
  orderDateKey          String?
  orderSeq              Int?
  orderCode             String?     @unique
  buyerType             BuyerType
  buyerGuestTokenHash   String?     @db.VarChar(128)
  bagOption             Boolean     @default(false)
  impUid                String?     @unique
  inquiries             Inquiry[]
  user                  User?       @relation(fields: [userId], references: [id])
  items                 OrderItem[]

  @@unique([orderDateKey, productType, orderSeq])
  @@index([userId])
  @@index([productType, receiveMethod])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([orderDate])
  @@index([orderDateKey, productType])
  @@index([bankCode])
  @@index([cardCompany])
  @@index([easyPayProvider])
}

model OrderSequence {
  orderDateKey String
  productType  Int
  lastSeq      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([orderDateKey, productType])
}

model OrderItem {
  id              String               @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  price           Int
  optionData      Json?
  createdAt       DateTime             @default(now())
  productType     Int
  onsiteProductId String?
  onsiteOptionId  String?
  order           Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product              @relation(fields: [productId], references: [id])
  onsiteProduct   OnsiteProduct?       @relation(fields: [onsiteProductId], references: [productId], onDelete: SetNull)
  onsiteOption    OnsiteProductOption? @relation(fields: [onsiteOptionId], references: [optionId], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([onsiteProductId])
  @@index([onsiteOptionId])
}

/// QRshop(/Fair) 메뉴별 재고. qrItemId 는 app/QRshop/item.json 의 id 와 동일
model FairShopProduct {
  id           String   @id @default(cuid())
  qrItemId     String   @unique
  initStock    Int
  /// 판매 가능 재고(결제 확정 시 감소)
  stock        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// 미충족 수요 누적(판매 재고 0일 때 결제 시도마다 요청 수량만큼 감소 → 음수). 분석용.
  currentStock Int      @default(0)

  @@map("FairShopProductTable")
}

/// QRshop 상점. storeSlug는 상점URL 식별자
model Store {
  storeId   String  @id @default(cuid())
  /// 상점 소유자. 1인 1상점이므로 unique. 유저가 지워져도 상점 데이터는 남긴다.
  userId    String? @unique
  name      String
  storeSlug String  @unique
  /// 판매자 화면에 `@handle` 형태로 노출되는 표시용 아이디.
  handle    String? @unique
  /// 상점 프로필 이미지.
  imageUrl  String?

  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  user       User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  categories OnsiteProductCategory[]
  products   OnsiteProduct[]
}

/// QRshop 상점별 상품 카테고리. 상품은 카테고리를 갖지 않을 수 있음
model OnsiteProductCategory {
  categoryId String          @id @default(cuid())
  storeId    String
  name       String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  store      Store           @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  products   OnsiteProduct[]

  @@unique([storeId, name])
  @@index([storeId])
}

/// QRshop 상품.
/// price는 hasOption 여부와 무관하게 항상 존재하는 **기본가**다.
/// 옵션을 쓰면 최종가 = price + OnsiteProductOption.surcharge 이고,
/// initStock/currentStock은 옵션 재고의 합계를 담는다(옵션 미사용이면 입력값 그대로).
/// price/initStock/currentStock >= 0 은 DB CHECK 제약으로 강제(마이그레이션 참고, Prisma 스키마 문법상 표현 불가).
model OnsiteProduct {
  productId      String                 @id @default(cuid())
  storeId        String
  categoryId     String?
  name           String                 @db.VarChar(20)
  hasOption      Boolean                @default(false)
  price          Int /// 기본가(0 이상). 옵션 사용 시에도 유지한다.
  initStock      Int /// 최초 재고(0 이상). 옵션 사용 시 옵션 initStock 합계.
  currentStock   Int /// 판매 가능 재고(결제 확정 시 차감). 옵션 사용 시 옵션 currentStock 합계.
  /// 상품 대표 이미지.
  imageUrl       String?
  /// item.json/FairShopProductTable 이관 추적용(임시). 이관 검증 끝나면 삭제 예정.
  legacyQrItemId String?                @unique
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  store          Store                  @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  category       OnsiteProductCategory? @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)
  options        OnsiteProductOption[]
  orderItems     OrderItem[]

  @@index([storeId])
  @@index([categoryId])
}

/// QRshop 상품 옵션. 상품이 hasOption=true 일 때만 사용된다.
/// surcharge는 절대가격이 아니라 상품 기본가에 **더하는 금액**이다.
/// surcharge/initStock/currentStock >= 0 은 DB CHECK 제약으로 강제(마이그레이션 참고, Prisma 스키마 문법상 표현 불가).
model OnsiteProductOption {
  optionId       String        @id @default(cuid())
  productId      String
  name           String        @db.VarChar(18)
  /// 기본가에 더해지는 추가금(0 이상).
  surcharge      Int           @default(0)
  initStock      Int
  currentStock   Int /// 판매 가능 재고(결제 확정 시 차감)
  legacyQrItemId String?       @unique /// item.json 이관 추적용(임시). 이관 검증 끝나면 삭제 예정.
  product        OnsiteProduct @relation(fields: [productId], references: [productId], onDelete: Cascade)
  orderItems     OrderItem[]

  @@unique([productId, name])
  @@index([productId])
}

model Scrap {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  productId String?
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@unique([userId, productId])
  @@index([userId])
  @@index([projectId])
  @@index([productId])
}

model Image {
  id        String   @id @default(cuid()) @map("imageId")
  usage     String
  fileSize  Int
  mimeType  String
  imageUrl  String   @default("")
  data      Bytes?
  createdAt DateTime @default(now())

  @@index([usage])
  @@map("Image")
}

model ProjectCategory {
  id       String    @id @default(cuid()) @map("categoryId")
  category String
  projects Project[]

  @@map("Project Category")
}

model ProjectYear {
  id       String    @id @default(cuid()) @map("yearId")
  year     Int
  projects Project[]

  @@map("Project Year")
}

model Project {
  title         String
  likeCount     Int             @default(0)
  viewCount     Int             @default(0)
  isPublic      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  categoryId    String
  detailUrl     String
  hardDeleteAt  DateTime?
  isHome        Boolean         @default(false) @map("ishome")
  id            String          @id @default(cuid()) @map("projectId")
  softDeletedAt DateTime?
  teamId        String
  thumbnailUrl  String
  yearId        String
  likes         Like[]
  category      ProjectCategory @relation(fields: [categoryId], references: [id])
  team          Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projectYear   ProjectYear     @relation(fields: [yearId], references: [id])
  scraps        Scrap[]

  @@index([teamId])
  @@index([categoryId])
  @@index([yearId])
  @@index([isPublic])
  @@index([isHome])
  @@index([softDeletedAt])
}

model Inquiry {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  content   String
  status    Int      @default(0)
  createdAt DateTime @default(now())
  order     Order?   @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([status])
}

model Settlement {
  id                  String    @id @default(cuid())
  orderId             String?
  teamId              String
  teamName            String
  grossAmount         Int
  productionCost      Int       @default(0)
  refundAmount        Int       @default(0)
  feeAmount           Int       @default(0)
  paidDate            DateTime?
  attachmentUrl       String?
  settlementStartDate DateTime
  settlementEndDate   DateTime
  status              Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  team                Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([status])
  @@index([settlementStartDate, settlementEndDate])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  productId String?
  projectId String?
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([userId, projectId])
  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([identifier])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      Int      @default(0)
  title     String
  content   String?
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  productId  String
  quantity   Int      @default(1)
  price      Int
  optionData Json?
  createdAt  DateTime @default(now())
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
}

model Term {
  id        String   @id @default(cuid())
  type      String
  mainTitle String
  subTitle  String?
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([order])
}

enum SignupMethod {
  EMAIL
  KAKAO
}

enum BuyerType {
  USER
  GUEST
}
