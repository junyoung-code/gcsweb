generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 유저 / 팀 ----------

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  password            String?
  nickname            String         @unique
  name                String
  phone               String?
  memberType          Int            @default(0)
  isSeller            Boolean        @default(false)
  studentId           String?
  major               String?
  profileImage        String?
  isVerified          Boolean        @default(false)
  signupMethod        SignupMethod   @default(EMAIL)
  isRepresentative    Boolean        @default(false)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  providerId          String?
  carts               Cart[]
  inquiries           Inquiry[]
  likes               Like[]
  notifications       Notification[]
  orders              Order[]
  scraps              Scrap[]
  store               Store?
  teams               Team[]

  @@index([email])
  @@index([nickname])
  @@index([memberType])
}

model Team {
  id                     String       @id @default(cuid())
  userId                 String
  teamName               String       @unique
  representativeName     String
  representativeNickname String
  teamMember             String[]
  teamMemberNickname     String[]
  accountUrl             String
  totalSales             Int?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  isSalesTeam            Boolean      @default(false)
  products               Product[]
  projects               Project[]
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teamName])
}

// ---------- 상품 (shop) ----------

model Product {
  id                  String           @id @default(cuid())
  teamId              String
  name                String
  description         String
  type                Int              @default(0)
  status              Int              @default(0)
  price               Int
  goalAmount          Int?
  currentAmount       Int              @default(0)
  salesStartDate      DateTime
  salesEndDate        DateTime
  productionStartDate DateTime?
  deliveryStartDate   DateTime?
  receiveMethod       Int?
  isPublic            Boolean          @default(false)
  likeCount           Int              @default(0)
  viewCount           Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  productionEndDate   DateTime?
  deliveryEndDate     DateTime?
  pickupStartDate     DateTime?
  pickupEndDate       DateTime?
  pickupLocation      String?
  isHome              Boolean          @default(false)
  isAdminApproved     Boolean          @default(false)
  publicAt            DateTime?
  cartItems           CartItem[]
  likes               Like[]
  orderItems          OrderItem[]
  team                Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  images              ProductImage[]   @relation("ProductImages")
  options             ProductOption[]
  variants            ProductVariant[]
  scraps              Scrap[]

  @@index([teamId])
  @@index([type])
  @@index([status])
  @@index([isPublic])
}

model ProductOption {
  id         String               @id @default(cuid())
  productId  String
  optionName String
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values     ProductOptionValue[]

  @@unique([productId, optionName])
  @@index([productId])
}

model ProductOptionValue {
  id              String        @id @default(cuid())
  optionId        String
  value           String
  additionalPrice Int           @default(0)
  productId       String
  optionName      String
  option          ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, value])
  @@index([optionId])
  @@index([productId])
  @@index([productId, optionName])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  variantName     String?
  unitPrice       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isSoldOut       Boolean  @default(false)
  optionSignature String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, optionSignature])
  @@index([productId])
  @@index([productId, isSoldOut])
}

model ProductImage {
  id              String   @id @default(cuid())
  productId       String
  thumbnailImgUrl String
  detailImgUrl    String[]
  createdAt       DateTime @default(now())
  noticeImgUrl    String?
  product         Product  @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------- 주문 / 결제 ----------

model Order {
  id                    String      @id @default(cuid())
  userId                String?
  paymentAmount         Int
  orderDate             DateTime    @default(now())
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  productType           Int
  receiveMethod         Int
  receiverName          String?
  receiverPhone         String?
  deliveryZipCode       String?
  deliveryAddressMain   String?
  deliveryAddressDetail String?
  deliveryMessage       String?
  ordererName           String?
  ordererPhone          String?
  paymentStatus         PaymentStatus @default(PENDING) /// 결제상태 (수령상태와 별개 축)
  receiptStatus         ReceiptStatus @default(NOT_RECEIVED) /// 수령상태 (결제상태와 연동하지 않음)
  paymentMethod         PaymentMethod /// 결제방법 (세부 PG 수단은 사이트가 나누지 않음)
  cardCompany           Int?
  bankCode              Int?
  easyPayProvider       Int?
  billingKey            String?
  orderDateKey          String?
  orderSeq              Int?
  orderCode             String?     @unique
  buyerType             BuyerType
  buyerGuestTokenHash   String?     @db.VarChar(128)
  bagOption             Boolean     @default(false)
  impUid                String?     @unique
  inquiries             Inquiry[]
  user                  User?       @relation(fields: [userId], references: [id])
  items                 OrderItem[]

  @@unique([orderDateKey, productType, orderSeq])
  @@index([userId])
  @@index([productType, receiveMethod])
  @@index([paymentStatus])
  @@index([receiptStatus])
  @@index([orderDate])
  @@index([orderDateKey, productType])
  @@index([bankCode])
  @@index([cardCompany])
  @@index([easyPayProvider])
}

model OrderSequence {
  orderDateKey String
  productType  Int
  lastSeq      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([orderDateKey, productType])
}

model OrderItem {
  id              String               @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  price           Int
  optionData      Json?
  createdAt       DateTime             @default(now())
  productType     Int
  onsiteProductId String?
  onsiteOptionId  String?
  order           Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product              @relation(fields: [productId], references: [id])
  onsiteProduct   OnsiteProduct?       @relation(fields: [onsiteProductId], references: [productId], onDelete: SetNull)
  onsiteOption    OnsiteProductOption? @relation(fields: [onsiteOptionId], references: [optionId], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([onsiteProductId])
  @@index([onsiteOptionId])
}

// ---------- 상품 (QRshop) ----------

/// QRshop(/Fair) 메뉴별 재고. qrItemId 는 app/QRshop/item.json 의 id 와 동일
model FairShopProduct {
  id           String   @id @default(cuid())
  qrItemId     String   @unique
  initStock    Int
  stock        Int /// 판매 가능 재고(결제 확정 시 감소)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  currentStock Int      @default(0) /// 미충족 수요 누적(판매 재고 0일 때 결제 시도마다 요청 수량만큼 감소 → 음수). 분석용

  @@map("FairShopProductTable")
}

/// QRshop 상점
model Store {
  storeId   String  @id @default(cuid())
  userId    String? @unique /// 1인 1상점이므로 unique. 소유자(User)가 삭제되도 판매이력이 있는 상점은 삭제되지 않음 (userId null로 유지, SetNull)
  name      String  @db.VarChar(16)
  storeSlug String  @unique         // 상점URL 식별자
  imageUrl  String? /// 상점 프로필 이미지
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  user       User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  categories OnsiteProductCategory[]
  products   OnsiteProduct[]
}

/// QRshop 상점별 상품 카테고리. 상품은 카테고리를 갖지 않을 수 있음
model OnsiteProductCategory {
  categoryId String          @id @default(cuid())
  storeId    String
  name       String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  store      Store           @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  products   OnsiteProduct[]

  @@unique([storeId, name])
  @@index([storeId])
}

/// QRshop 상품
model OnsiteProduct {
  productId      String                 @id @default(cuid())
  storeId        String
  categoryId     String?
  name           String                 @db.VarChar(20)
  hasOption      Boolean                @default(false)
  price          Int /// 기본가(0 이상, DB CHECK로 강제). hasOption 여부와 무관하게 항상 존재, 옵션 사용 시 최종가 = price + 옵션 surcharge
  initStock      Int /// 최초 재고(0 이상, DB CHECK로 강제). 옵션 사용 시 옵션 initStock 합계
  currentStock   Int /// 판매 가능 재고(0 이상, DB CHECK로 강제, 결제 확정 시 차감). 옵션 사용 시 옵션 currentStock 합계
  imageUrl       String? /// 상품 대표 이미지
  legacyQrItemId String?                @unique /// item.json/FairShopProductTable 이관 추적용(임시). 이관 검증 끝나면 삭제 예정
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  store          Store                  @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  category       OnsiteProductCategory? @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)
  options        OnsiteProductOption[]
  orderItems     OrderItem[]

  @@index([storeId])
  @@index([categoryId])
}

/// QRshop 상품 옵션. 상품이 hasOption=true 일 때만 사용
model OnsiteProductOption {
  optionId       String        @id @default(cuid())
  productId      String
  name           String        @db.VarChar(18)
  surcharge      Int           @default(0) /// 기본가에 더해지는 추가금(0 이상, 절대가격 아님, DB CHECK로 강제)
  initStock      Int /// 최초 재고(0 이상, DB CHECK로 강제)
  currentStock   Int /// 판매 가능 재고(0 이상, DB CHECK로 강제, 결제 확정 시 차감)
  legacyQrItemId String?       @unique /// item.json 이관 추적용(임시). 이관 검증 끝나면 삭제 예정.
  product        OnsiteProduct @relation(fields: [productId], references: [productId], onDelete: Cascade)
  orderItems     OrderItem[]

  @@unique([productId, name])
  @@index([productId])
}

// ---------- 장바구니 ----------

model Cart {
  id        String     @id @default(cuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  productId  String
  quantity   Int      @default(1)
  price      Int
  optionData Json?
  createdAt  DateTime @default(now())
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
}

// ---------- 프로젝트 (archive) ----------

model ProjectCategory {
  id       String    @id @default(cuid()) @map("categoryId")
  category String
  projects Project[]

  @@map("Project Category")
}

model ProjectYear {
  id       String    @id @default(cuid()) @map("yearId")
  year     Int
  projects Project[]

  @@map("Project Year")
}

model Project {
  title         String
  likeCount     Int             @default(0)
  viewCount     Int             @default(0)
  isPublic      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  categoryId    String
  detailUrl     String
  hardDeleteAt  DateTime?
  isHome        Boolean         @default(false) @map("ishome")
  id            String          @id @default(cuid()) @map("projectId")
  softDeletedAt DateTime?
  teamId        String
  thumbnailUrl  String
  yearId        String
  likes         Like[]
  category      ProjectCategory @relation(fields: [categoryId], references: [id])
  team          Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projectYear   ProjectYear     @relation(fields: [yearId], references: [id])
  scraps        Scrap[]

  @@index([teamId])
  @@index([categoryId])
  @@index([yearId])
  @@index([isPublic])
  @@index([isHome])
  @@index([softDeletedAt])
}

// ---------- 사용자 활동 (좋아요 / 스크랩 / 알림 / 문의) ----------

model Like {
  id        String   @id @default(cuid())
  userId    String
  productId String?
  projectId String?
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([userId, projectId])
  @@index([userId])
}

model Scrap {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  productId String?
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@unique([userId, productId])
  @@index([userId])
  @@index([projectId])
  @@index([productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      Int      @default(0)
  title     String
  content   String?
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Inquiry {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  content   String
  status    Int      @default(0)
  createdAt DateTime @default(now())
  order     Order?   @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([status])
}

// ---------- 공통 (이미지 / 인증토큰 / 약관) ----------

model Image {
  id        String   @id @default(cuid()) @map("imageId")
  usage     String
  fileSize  Int
  mimeType  String
  imageUrl  String   @default("")
  data      Bytes?
  createdAt DateTime @default(now())

  @@index([usage])
  @@map("Image")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([identifier])
}

model Term {
  id        String   @id @default(cuid())
  type      String
  mainTitle String
  subTitle  String?
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([order])
}

// ---------- Enum ----------

enum SignupMethod {
  EMAIL
  KAKAO
}

enum BuyerType {
  USER
  GUEST
}

enum PaymentStatus {
  PENDING /// 대기
  PAID /// 완료
  CANCELED /// 취소
  FAILED /// 실패
}

enum PaymentMethod {
  ONLINE /// 온라인결제
  ON_SITE /// 현장결제
}

enum ReceiptStatus {
  NOT_RECEIVED /// 미수령
  RECEIVED /// 수령완료
}
